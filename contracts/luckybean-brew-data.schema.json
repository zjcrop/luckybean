{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zjcrop.github.io/luckybean/contracts/luckybean-brew-data.schema.json",
  "title": "LuckyBean Stable Brew Data",
  "type": "object",
  "required": [
    "bean",
    "brew",
    "water",
    "environment",
    "targets"
  ],
  "properties": {
    "bean": {
      "type": "object",
      "additionalProperties": true
    },
    "brew": {
      "type": "object",
      "required": [
        "doseG",
        "ratio",
        "profileId"
      ],
      "properties": {
        "doseG": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "doseMode": {
          "type": "string",
          "enum": ["auto", "manual"]
        },
        "serveMode": {
          "type": "string",
          "enum": ["hot", "cold"]
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "dripperMaterial": {
          "type": "string",
          "enum": ["glass", "ceramic", "plastic", "titanium"],
          "description": "Filter-cup material consumed by the BrewProfiles thermal model."
        }
      },
      "additionalProperties": true
    },
    "water": {
      "type": "object",
      "properties": {
        "tdsMgL": { "$ref": "#/$defs/nullableWaterConcentration" },
        "alkalinityMgLAsCaCO3": { "$ref": "#/$defs/nullableWaterConcentration" },
        "recipeVolumeL": { "type": "number", "exclusiveMinimum": 0 },
        "concentrationBasis": {
          "type": "string",
          "enum": ["provided-unspecified", "pre-heating-calculated", "source-water-measured", "post-heating-measured"]
        },
        "ionsMgL": {
          "type": ["object", "null"],
          "properties": {
            "Ca": { "$ref": "#/$defs/nullableWaterConcentration" },
            "Mg": { "$ref": "#/$defs/nullableWaterConcentration" },
            "Na": { "$ref": "#/$defs/nullableWaterConcentration" },
            "K": { "$ref": "#/$defs/nullableWaterConcentration" },
            "HCO3": { "$ref": "#/$defs/nullableWaterConcentration" },
            "CO3": { "$ref": "#/$defs/nullableWaterConcentration" },
            "Cl": { "$ref": "#/$defs/nullableWaterConcentration" },
            "SO4": { "$ref": "#/$defs/nullableWaterConcentration" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "properties": {
        "beverageTdsPct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "beverageMassG": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000 },
        "doseG": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10000 }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "targets": {
      "type": "object",
      "required": [
        "acidity",
        "floral",
        "fruity",
        "sweetness",
        "bitterness",
        "astringency"
      ],
      "properties": {
        "acidity": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "floral": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "fruity": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "sweetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "bitterness": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Suppression/control priority for bitterness."
        },
        "astringency": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Suppression/control priority for astringency."
        }
      },
      "not": {
        "required": [
          "body"
        ]
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "schemaVersion"
        ]
      },
      {
        "required": [
          "appVersion"
        ]
      },
      {
        "required": [
          "engineVersion"
        ]
      },
      {
        "required": [
          "profileVersion"
        ]
      }
    ]
  },
  "additionalProperties": true,
  "$defs": {
    "nullableWaterConcentration": { "type": ["number", "null"], "minimum": 0, "maximum": 10000 }
  }
}
