{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zjcrop.github.io/luckybean/contracts/luckybean-brew-data.schema.json",
  "title": "LuckyBean Stable Brew Data",
  "type": "object",
  "required": [
    "bean",
    "brew",
    "water",
    "environment",
    "targets"
  ],
  "properties": {
    "bean": {
      "type": "object",
      "additionalProperties": true
    },
    "brew": {
      "type": "object",
      "required": [
        "doseG",
        "ratio",
        "profileId"
      ],
      "properties": {
        "doseG": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "doseMode": {
          "type": "string",
          "enum": ["auto", "manual"]
        },
        "serveMode": {
          "type": "string",
          "enum": ["hot", "cold"]
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "dripperMaterial": {
          "type": "string",
          "enum": ["glass", "ceramic", "plastic", "titanium"],
          "description": "Filter-cup material consumed by the BrewProfiles thermal model."
        }
      },
      "additionalProperties": true
    },
    "water": {
      "type": "object",
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "targets": {
      "type": "object",
      "required": [
        "acidity",
        "floral",
        "fruity",
        "sweetness",
        "bitterness",
        "astringency"
      ],
      "properties": {
        "acidity": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "floral": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "fruity": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "sweetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "bitterness": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Suppression/control priority for bitterness."
        },
        "astringency": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Suppression/control priority for astringency."
        }
      },
      "not": {
        "required": [
          "body"
        ]
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "schemaVersion"
        ]
      },
      {
        "required": [
          "appVersion"
        ]
      },
      {
        "required": [
          "engineVersion"
        ]
      },
      {
        "required": [
          "profileVersion"
        ]
      }
    ]
  },
  "additionalProperties": true
}
