{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckybean.local/contracts/recognition-date-decision-v1.schema.json",
  "title": "LuckyBean Recognition Date Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classifierVersion", "roastDate", "candidates", "reviewRequired", "excludedCount"],
  "properties": {
    "schemaVersion": { "const": "recognition-date-decision/1.0" },
    "classifierVersion": { "type": "string", "minLength": 1 },
    "roastDate": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewRequired": { "type": "boolean" },
    "excludedCount": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rawValue", "normalizedValue", "values", "fieldType", "fieldLabel", "decision", "confidence", "imageId", "imageRole", "blockId", "polygon", "labelEvidence", "warnings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rawValue": { "type": "string", "minLength": 1 },
          "normalizedValue": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
          "fieldType": { "enum": ["roastDate", "productionDate", "packDate", "bestBefore", "expiryDate", "harvest", "unknown"] },
          "fieldLabel": { "type": "string" },
          "decision": { "enum": ["auto-fill", "exclude", "review"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "imageId": { "type": "string", "minLength": 1 },
          "imageRole": { "enum": ["front", "back", "side", "date", "text"] },
          "blockId": { "type": "string", "minLength": 1 },
          "polygon": { "type": ["array", "null"] },
          "labelEvidence": { "type": "string" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
