{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckybean.local/contracts/recognition-document-v1.schema.json",
  "title": "LuckyBean RecognitionDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parserVersion", "engine", "createdAt", "images", "blocks", "fullText"],
  "properties": {
    "schemaVersion": { "const": "recognition-document/1.0" },
    "parserVersion": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "fullText": { "type": "string" },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "roleLabel", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["front", "back", "side", "date", "text"] },
          "roleLabel": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "imageId", "imageRole", "order", "text", "confidence", "polygon", "engine"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "imageId": { "type": "string", "minLength": 1 },
          "imageRole": { "enum": ["front", "back", "side", "date", "text"] },
          "order": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "polygon": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
                }
              }
            ]
          },
          "engine": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
