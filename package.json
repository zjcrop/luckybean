{
  "name": "luckybean-static-app",
  "private": true,
  "version": "1.24.18",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-vendor.mjs",
    "prepare:ocr": "node scripts/prepare-paddleocr-vendor.mjs && node scripts/verify-ocr-runtime.mjs",
    "verify:ocr": "node scripts/verify-ocr-runtime.mjs",
    "test:recognition": "node --test test/*.test.js",
    "test:ocr-integrity": "node --test test/ocr-worker-compression-integrity.test.js",
    "test:static": "node scripts/run-static-tests.mjs",
    "test:smoke": "playwright test tests/v110-startup-smoke.spec.mjs tests/v124p-startup-auth-hotfix.spec.mjs tests/v123e-ui-interaction.spec.mjs tests/v124b-ocr-worker-runtime.spec.mjs tests/v124p-gallery-upload-flow.spec.mjs --browser=chromium --reporter=line --workers=1 --retries=1",
    "test:core": "node scripts/run-core-tests.mjs",
    "test:visual": "playwright test tests/v120-visual-baseline.spec.mjs --browser=chromium --reporter=line",
    "test:live-brewprofiles": "node scripts/run-live-brewprofiles-gate.mjs",
    "test:webkit": "playwright test tests/v124p-webkit-auth-ocr.spec.mjs --browser=webkit --reporter=line --workers=1"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
